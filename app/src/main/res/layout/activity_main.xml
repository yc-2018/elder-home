<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elder_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择要放到桌面的应用"
        android:textColor="@color/elder_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="正在读取应用..."
        android:textColor="@color/elder_muted"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addBatteryButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="添加大电量"
            android:textColor="@color/elder_accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/addClockButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="添加大钟表"
            android:textColor="@color/elder_accent"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/addUrlButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_secondary"
        android:text="添加 URL 入口"
        android:textColor="@color/elder_accent"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/appList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:divider="#D8D8D0"
        android:dividerHeight="1dp"
        android:fastScrollEnabled="true" />
</LinearLayout>
