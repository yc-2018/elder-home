<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/configScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elder_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置桌面入口"
            android:textColor="@color/elder_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chosenAppText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="当前应用：未选择"
            android:textColor="@color/elder_muted"
            android:textSize="17sp" />

        <Button
            android:id="@+id/chooseAppButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_secondary"
            android:text="选择应用"
            android:textColor="@color/elder_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/urlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="应用 URL"
                android:textColor="@color/elder_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/urlEdit"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_bg"
                android:hint="xhsdiscover://search/result"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/elder_text"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="桌面显示名称"
                android:textColor="@color/elder_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/nameEdit"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_bg"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/elder_text"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="占用桌面格子"
                android:textColor="@color/elder_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="宽"
                    android:textColor="@color/elder_text"
                    android:textSize="18sp" />

                <Spinner
                    android:id="@+id/widthSpinner"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="高"
                    android:textColor="@color/elder_text"
                    android:textSize="18sp" />

                <Spinner
                    android:id="@+id/heightSpinner"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="图标"
                android:textColor="@color/elder_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iconPreview"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <Button
                android:id="@+id/defaultIconButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_secondary"
                android:text="使用应用默认图标"
                android:textColor="@color/elder_accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/appIconButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:text="从应用列表选图标"
                android:textColor="@color/elder_accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/pickImageButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:text="选择自己的图片"
                android:textColor="@color/elder_accent"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/helpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="点击添加后，桌面会弹出确认窗口。若没有弹出，请长按桌面，进入小部件，选择对应尺寸的大应用入口。"
            android:textColor="@color/elder_muted"
            android:textSize="17sp" />

        <Button
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_primary"
            android:text="添加到桌面"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
